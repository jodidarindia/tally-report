# Tally Reports - Environment Configuration
# Copy this file to .env and fill in the values

# Required: Your Emergent LLM Key for AI features (Purchase Order, AI Reports)
EMERGENT_LLM_KEY=your_emergent_llm_key_here

# Optional: Resend API Key for email OTP (leave blank for dev mode with static OTP 123456)
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev

# Optional: Your domain/IP for the frontend to reach the backend
# For local: http://localhost
# For server: https://your-domain.com
APP_URL=http://localhost
