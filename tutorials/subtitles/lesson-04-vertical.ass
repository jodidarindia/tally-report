Dialogue: 0,0:00:00.00,0:00:02.57,Default,,0,0,0,,FLOWRA multi-company support karta hai
Dialogue: 0,0:00:02.57,0:00:06.29,Default,,0,0,0,,matlab agar aapke paas ek se zyada Tally companies hain
Dialogue: 0,0:00:06.29,0:00:10.88,Default,,0,0,0,,toh aap dashboard ke upar company selector se switch kar sakte hain.
Dialogue: 0,0:00:10.88,0:00:16.22,Default,,0,0,0,,Naam pe click kariye — list khulegi — jo company dekhni hai us pe click kariye.
Dialogue: 0,0:00:16.22,0:00:18.100,Default,,0,0,0,,Data automatic uss company ka aa jaayega.
Dialogue: 0,0:00:18.100,0:00:22.92,Default,,0,0,0,,Waisi hi tarah FY selector — abhi FY 2026-27 selected hai.
Dialogue: 0,0:00:22.92,0:00:27.11,Default,,0,0,0,,Aap 2025-26 ya kisi bhi previous year ka data dekh sakte hain.
Dialogue: 0,0:00:27.11,0:00:28.51,Default,,0,0,0,,Ek tip
Dialogue: 0,0:00:28.51,0:00:35.47,Default,,0,0,0,,agar aap sales ya outstanding ka trend dekhna chahte hain toh alag alag FY switch karke compare kariye.
Dialogue: 0,0:00:35.47,0:00:39.89,Default,,0,0,0,,Chalo agle video mein Owner track shuru karte hain — KPI cards padhna seekhenge.
