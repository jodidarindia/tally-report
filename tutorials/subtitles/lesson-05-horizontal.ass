Dialogue: 0,0:00:00.00,0:00:04.34,Default,,0,0,0,,Owner ke liye pehla lesson — Dashboard ke chaar KPI cards ka matlab.
Dialogue: 0,0:00:04.34,0:00:08.23,Default,,0,0,0,,Pehla card, Total Sales — is FY mein aapki poori sales value.
Dialogue: 0,0:00:08.23,0:00:12.88,Default,,0,0,0,,Neeche chhote akshar mein compare hai — pichhle FY se kitna zyada ya kam.
Dialogue: 0,0:00:12.88,0:00:17.22,Default,,0,0,0,,Doosra card, Total Orders — kitne unique sales vouchers banaye gaye.
Dialogue: 0,0:00:17.22,0:00:21.55,Default,,0,0,0,,Teesra card, Outstanding Amount — customers ne kitna paisa dena hai.
Dialogue: 0,0:00:21.55,0:00:24.74,Default,,0,0,0,,Yeh number jitna kam ho, utna hi business healthy.
Dialogue: 0,0:00:24.74,0:00:29.91,Default,,0,0,0,,Chautha card, Beat Coverage — kitne percent customers ko is week visit kiya gaya.
Dialogue: 0,0:00:29.91,0:00:34.50,Default,,0,0,0,,Agar Beat Coverage 60 percent se kam hai, toh sales team ko push kariye.
Dialogue: 0,0:00:34.50,0:00:37.69,Default,,0,0,0,,In chaar numbers ko har subah phone pe dekh lijiye
Dialogue: 0,0:00:37.69,0:00:41.83,Default,,0,0,0,,30 second mein pata chal jaayega ki business kaisa chal raha hai.
