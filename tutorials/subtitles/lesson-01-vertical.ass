Dialogue: 0,0:00:00.00,0:00:01.40,Default,,0,0,0,,Namaste!
Dialogue: 0,0:00:01.40,0:00:04.68,Default,,0,0,0,,Main FLOWRA hoon — aapke business ka digital brain.
Dialogue: 0,0:00:04.68,0:00:06.67,Default,,0,0,0,,Aap Tally ya Busy chalate hain?
Dialogue: 0,0:00:06.67,0:00:09.88,Default,,0,0,0,,Toh aap jaante hain data toh sab computer mein hai
Dialogue: 0,0:00:09.88,0:00:12.71,Default,,0,0,0,,lekin dekhne ke liye office jaana padta hai.
Dialogue: 0,0:00:12.71,0:00:18.10,Default,,0,0,0,,Mobile se sales dekhni ho outstanding check karna ho ya salesman ka target dekhna ho
Dialogue: 0,0:00:18.10,0:00:20.22,Default,,0,0,0,,sab kuch phone pe milna chaahiye.
Dialogue: 0,0:00:20.22,0:00:21.62,Default,,0,0,0,,Sahi baat?
Dialogue: 0,0:00:21.62,0:00:23.62,Default,,0,0,0,,Bas yehi kaam FLOWRA karta hai.
Dialogue: 0,0:00:23.62,0:00:28.88,Default,,0,0,0,,Ek chhoti si desktop app aapka Tally ya Busy ka data har roz cloud pe le jaati hai
Dialogue: 0,0:00:28.88,0:00:30.28,Default,,0,0,0,,automatic.
Dialogue: 0,0:00:30.28,0:00:33.24,Default,,0,0,0,,Aur aap kahin se bhi ghar dukaan ya safar mein
Dialogue: 0,0:00:33.24,0:00:36.77,Default,,0,0,0,,apne mobile ya laptop pe pura business dekh sakte hain.
Dialogue: 0,0:00:36.77,0:00:41.33,Default,,0,0,0,,Sales report customer wise outstanding inventory aur ABC categorisation
Dialogue: 0,0:00:41.33,0:00:45.70,Default,,0,0,0,,salesman ke targets CA corner mein reconciliation sab kuch ek jagah.
Dialogue: 0,0:00:45.70,0:00:50.30,Default,,0,0,0,,Aage ke videos mein hum ek-ek karke sab feature dekhenge, bilkul aasan bhaasha mein.
Dialogue: 0,0:00:50.30,0:00:50.30,Default,,0,0,0,,Chaliye shuru karte hain!
