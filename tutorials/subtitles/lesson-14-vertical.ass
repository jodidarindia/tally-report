Dialogue: 0,0:00:00.00,0:00:02.83,Default,,0,0,0,,CRM ka teesra section — Payment Behaviour.
Dialogue: 0,0:00:02.83,0:00:06.12,Default,,0,0,0,,Har customer ka payment pattern analyse hota hai.
Dialogue: 0,0:00:06.12,0:00:09.69,Default,,0,0,0,,Pay Ratio dikhta hai — kitna sales value pay ho gaya.
Dialogue: 0,0:00:09.69,0:00:13.73,Default,,0,0,0,,80 percent se upar green, 50 se 80 yellow, 50 se neeche red.
Dialogue: 0,0:00:13.73,0:00:17.70,Default,,0,0,0,,Avg Delay bhi hai — average kitne din late paise aate hain.
Dialogue: 0,0:00:17.70,0:00:21.13,Default,,0,0,0,,Score column ek combined rating hai — 0 se 100 tak.
Dialogue: 0,0:00:21.13,0:00:24.63,Default,,0,0,0,,High score matlab reliable customer, credit badhaao.
Dialogue: 0,0:00:24.63,0:00:28.27,Default,,0,0,0,,Low score matlab careful raho, advance payment maango.
Dialogue: 0,0:00:28.27,0:00:33.72,Default,,0,0,0,,Yeh data business decisions mein bahut useful hai kis customer ko credit dena hai
Dialogue: 0,0:00:33.72,0:00:34.39,Default,,0,0,0,,kise nahi.
